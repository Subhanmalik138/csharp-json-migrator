<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>jsonmigrate</AssemblyName>
    <RootNamespace>JsonMigrator.Cli</RootNamespace>
    <Description>CLI for the JsonMigrator library: run declarative JSON migrations from plan files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonMigrator\JsonMigrator.csproj" />
  </ItemGroup>

</Project>
